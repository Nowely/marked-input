{
  "name": "@markput/monorepo",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @markput/storybook dev",
    "dev:react:app": "vp run --filter @markput/react-app dev",
    "dev:vue:app": "vp run --filter @markput/vue-app dev",
    "dev:sb:react": "vp run --filter @markput/storybook dev:react",
    "dev:sb:vue": "vp run --filter @markput/storybook dev:vue",
    "dev:website": "vp run --filter @markput/website dev",
    "build": "vp run -r build",
    "build:react": "vp run --filter @markput/react build",
    "build:react:sb": "vp run --filter @markput/storybook build:react",
    "build:vue": "vp run --filter @markput/vue build",
    "build:vue:sb": "vp run --filter @markput/storybook build:vue",
    "test": "vp test run",
    "test:ui": "vp test watch --ui",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "test:related": "vp test run --changed",
    "bench": "vp test bench --run --reporter=verbose",
    "lint": "vp lint . --fix",
    "lint:check": "vp lint .",
    "lint:fix:suggest": "vp lint . --fix-suggestions",
    "lint:fix:danger": "vp lint . --fix-dangerously",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vp run -r typecheck",
    "git:clean": "git clean -xdf",
    "git:clean:dry": "git clean -xdn",
    "git:restart": "git fetch --prune origin && git fetch origin next:next && git switch -C \"$(git branch --show-current)\" next && git push --force-with-lease -u origin HEAD",
    "preinstall": "npx only-allow pnpm",
    "publish": "vp run --filter @markput/react publish",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "pnpm": ">=9"
  }
}
