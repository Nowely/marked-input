  <div>
    <span>See the </span>
    <span contenteditable="false">
      <span>Apollo architecture RFC</span>
    </span>
    <span> for the conflict-resolution and presence protocols.</span>
  </div>
  <div contenteditable="false"></div>
</div>"
`;

