            </span>
          </span>
          <span></span>
        </span>
      </span>
    </span>
    <span></span>
  </div>
  <div>
    <span></span>
    <span>
      <span>
        <span>
          <span>Canary procedure</span>
        </span>
      </span>
    </span>
    <span></span>
  </div>
  <div>
    <span></span>
    <span contenteditable="false">
      <span>apollo deploy --env=staging --canary=5%&#10;# → rollout 5% · healthy · p95 184ms&#10;</span>
    </span>
    <span></span>
