{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "moduleSuffixes": [".vue", ""]
  },
  "include": [
    "**/*.vue",
    "**/*.vue.ts",
    "**/*.vue.spec.ts",
    "src/pages/**/*.spec.ts",
    "src/pages/**/*.stories.ts",
    ".storybook/**/*.vue.ts",
    ".storybook/preview.ts",
    "src/shared/lib/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist-react", "dist-vue", "**/*.tsx", "**/*.react.ts"]
}
