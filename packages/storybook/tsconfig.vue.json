{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue"
  },
  "include": [
    "**/*.vue",
    "**/*.vue.ts",
    "**/*.vue.spec.ts",
