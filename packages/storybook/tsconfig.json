{
  // EDITOR ONLY. `pnpm run typecheck` uses tsconfig.react.json and tsconfig.vue.json, one program
  // per framework. An editor picks a single config per file, and the shared files
  // (`*.stories.ts`, `*.spec.ts`, `shared/lib/*`) belong to both — so this config resolves the
  // framework seam react-only, purely so go-to-definition and "cannot find module" behave.
  // `.vue` is deliberately NOT in the list: `moduleSuffixes` tries `.ts` for every suffix before
  // `.tsx` for any, so a `.vue.ts` file always beats its `.react.tsx` sibling and shared files end
  // up half-React half-Vue in one program. The cost is that a `*.vue.ts` file's seam imports
  // resolve to their React siblings here. This config merges both adapters into one program and
  // therefore reports pre-existing augmentation noise (TS2717/TS2604) that neither real project has.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "moduleSuffixes": [".react", ""]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue", ".storybook/**/*.ts"],
  "exclude": ["node_modules", "dist-react", "dist-vue"]
}
